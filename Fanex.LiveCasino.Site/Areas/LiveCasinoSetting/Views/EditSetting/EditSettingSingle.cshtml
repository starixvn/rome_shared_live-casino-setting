@{
    Layout = "~/Areas/LiveCasinoSetting/Views/EditSetting/_EditSetting.cshtml";
    ViewBag.Title = LiveCasinoLang.lblEditLiveCasino;
}
@model LiveCasinoSettingContext
@section modeldata
{
    <script type="text/javascript">
        @(Html.ToJavascriptObject(Model, "settingContext"))
    </script>
}
@section Customer
{
    <div id="tblCustInfo" class="col-xs-12">
        <table data-ng-controller="CustomerInfoController" class="cust-info">
            <tr class="title">
                <td colspan="4" class="center">
                    @LiveCasinoLang.lblCustomerInformation
                </td>
            </tr>
            <tr>
                <td class="right bold info-lable">
                    @LiveCasinoLang.lblUsername
                </td>
                <td class="left info-value">
                    @Model.Customer.Username
                </td>
                <td class="right bold info-lable">
                    @LiveCasinoLang.lblNickname
                </td>
                <td class="left info-value">
                    @if (LiveCasinoSettings.Settings.SystemId != (int)SystemType.Agency)
                    {
                        @Model.Customer.NickName
                    }
                </td>
            </tr>
            <tr>
                <td class="right bold info-lable">
                    @LiveCasinoLang.lblFirstName
                </td>
                <td class="left info-value">
                    @Model.Customer.FirstName
                </td>
                <td class="right bold info-lable">
                    @LiveCasinoLang.lblLastName
                </td>
                <td class="left info-value">
                    @Model.Customer.LastName
                </td>
            </tr>
            <tr>
                <td class="right bold info-lable">
                    @LiveCasinoLang.lblPhone
                </td>
                <td class="left info-value">
                    @Model.Customer.Phone
                </td>
                <td class="right bold info-lable">
                    @LiveCasinoLang.lblMobilePhone
                </td>
                <td class="left info-value">
                    @Model.Customer.Mobile
                </td>
            </tr>
            <tr>
                <td class="right bold info-lable">
                    @LiveCasinoLang.lblFax
                </td>
                <td class="left info-value">
                    @Model.Customer.Fax
                </td>
                @if (Model.Customer.Level == CustomerLevel.Member 
                    && Model.Upline.Level == CustomerLevel.Agent)
                {
                    <td class="right bold info-lable">
                        @LiveCasinoLang.lblEnable
                    </td>
                    <td class="left info-value">
                        <input type="checkbox" data-ng-model="enableLiveCasino" data-ng-disabled="disableCheckBoxLiveCasino" />
                    </td>
                }
                else
                {
                    <td class="right bold">
                    </td>
                    <td class="left">
                    </td>
                }
            </tr>
        </table>
    </div>
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/PTAndCom.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/MemberWinLimit.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/GameSetting.cshtml", Model)
    @Html.Hidden("UpdateLiveCasinoSettingUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdateLiveCasinoSetting"))
    @Html.Hidden("UpdatePTComSettingUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdatePTComSetting"))
    @Html.Hidden("UpdateWinLimitUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdateWinLimit"))
    @Html.Hidden("UpdateGameSettingUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdateGameSetting"))
}

