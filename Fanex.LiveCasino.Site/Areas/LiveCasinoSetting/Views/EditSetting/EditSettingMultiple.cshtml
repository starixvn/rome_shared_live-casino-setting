@{
    Layout = "~/Areas/LiveCasinoSetting/Views/EditSetting/_EditSetting.cshtml";
    ViewBag.Title = "EditSettingMultiple";
}
@model SettingContext

@section CustomerInfomation
{
    <div id="tblCustInfo" class="col-xs-12">
        <table data-ng-controller="CustomerInfoController" class="cust-info">
            <tbody>
                <tr>
                    <td class="bold left">
                        @(string.Join(", ", Model.TargetUsernames.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries)))
                    </td>
                </tr>
                @if (Model.IsAgentEditingMember)
                {
                    <tr>
                        <td class="right">
                            <label for="chbEnableLiveCasino">
                                <input id="chbEnableLiveCasino" type="checkbox" data-ng-model="enableLiveCasino"
                                    data-ng-disabled="disableCheckBoxLiveCasino" />@LiveCasinoLang.lblEnable</label>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@Html.Hidden("UpdateLiveCasinoSettingUrl", Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdateLiveCasinoSettingMultiple"))
@Html.Hidden("UpdatePtComSettingUrl", Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdatePtComSettingMultiple"))
@Html.Hidden("UpdateWinLimitUrl", Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdateWinLimitMultiple"))
@Html.Hidden("UpdateGameSettingUrl", Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdateGameSettingMultiple"))
