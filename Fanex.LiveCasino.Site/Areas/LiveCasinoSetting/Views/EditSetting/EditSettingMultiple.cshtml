@{
    Layout = "~/Areas/LiveCasinoSetting/Views/EditSetting/_EditSetting.cshtml";
    ViewBag.Title = LiveCasinoLang.lblEditMultipleLiveCasino;
    var customerNames = string.Join<string>(", ", Model.Customers.Select<Customer, string>(customer => customer.Username));
}
@model LiveCasinoSettingContextMultiple

@section modeldata
{
    <script type="text/javascript">
        @(Html.ToJavascriptObject(Model, "settingContext"))
    </script>
}

@section Customer
{
    <div id="tblCustInfo" class="col-xs-12">
        <table data-ng-controller="CustomerInfoController" class="cust-info">
            <tbody>
                <tr>
                    <td class="bold left">
                        @(customerNames)
                    </td>
                </tr>
                @if (Model.Customer.Level == CustomerLevel.Member 
                    && Model.Upline.Level == CustomerLevel.Agent)
                {
                    <tr>
                        <td class="right">
                            <label for="chbEnableLiveCasino">
                                <input id="chbEnableLiveCasino" type="checkbox" data-ng-model="enableLiveCasino"
                                    data-ng-disabled="disableCheckBoxLiveCasino" />@LiveCasinoLang.lblEnable</label>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/PTAndCom.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/MemberWinLimit.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/GameSetting.cshtml", Model)
    @Html.Hidden("UpdateLiveCasinoSettingUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdateMultipleLiveCasinoSetting"))
    @Html.Hidden("UpdatePTComSettingUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdateMultiplePTComSetting"))
    @Html.Hidden("UpdateWinLimitUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdateWinLimitMultiple"))
    @Html.Hidden("UpdateGameSettingUrl", Url.Content("~/LiveCasinoSetting/Setting/UpdateGameSettingMultiple"))
}


