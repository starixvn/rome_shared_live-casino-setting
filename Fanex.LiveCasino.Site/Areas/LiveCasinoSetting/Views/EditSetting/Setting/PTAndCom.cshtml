@model SettingContext
@{
    Layout = null;
}
<div id="tblPtComSetting" class="pt-container col-xs-12" 
    data-ng-controller="PtAndComSettingController"
    data-update-href="@Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdatePtAndComSetting")">
    <div class="pt-title">
        <span class="pt-title-text">Position Taking/Commission</span>
        <span data-ng-click="updatePtAndComSetting()" class="btn-save-partial"></span>
    </div>
    @switch ((CustRole)Model.TargetRoleId)
    {
        case CustRole.Super:
        <edit-super-pt-and-com></edit-super-pt-and-com>
            break;
        case CustRole.Master:
        <edit-master-pt-and-com></edit-master-pt-and-com>
            break;
        case CustRole.Agent:
            <edit-agent-pt-and-com></edit-agent-pt-and-com>
            break;
        case CustRole.Member:
            switch ((CustRole)Model.RoleId)
            {
                case CustRole.Super:
                    <super-edit-member-pt></super-edit-member-pt>
                    break;
                case CustRole.Master:
                    <master-edit-member-pt></master-edit-member-pt>
                    break;
                default:
                    <agent-edit-member-pt-and-com></agent-edit-member-pt-and-com>
                    break;
            }
            break;
    }


    <div id="presetOnMemberModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">
                        <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                    <h4 class="modal-title">
                        Confirm Update Member's PT</h4>
                </div>
                <div class="modal-body">
                    <p>You have changed this @(Model.TargetRoleId == (int)CustRole.Super ? "Super" : "Master") not to take auto position taking.</p>
                    <p>Do you want to update all member's position taking to:</p>
                     <select 
                        data-ng-model="ptAndComSetting.PositionTaking.NewPresetOnMember" 
                        data-ng-options="item.id as item.value for item in presetOnMemberOptions">
                        </select>
                    </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-ng-click="updatePresetOnMember(true)"  data-dismiss="modal">
                        Yes</button>
                    <button type="button" class="btn btn-primary" data-ng-click="updatePresetOnMember(false)" data-dismiss="modal">
                        No</button>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>
    <!-- /.modal -->
</div>
