@model LiveCasinoSettingContext
@{
    Layout = null;
}
<div id="tblPtComSetting" class="pt-container col-xs-12" 
    data-ng-controller="PtAndComSettingController"
    <div class="pt-title">
        <span class="pt-title-text">@LiveCasinoLang.lblPositionTakingCommission</span>
        <span data-ng-click="updatePtAndComSetting()" class="btn-save-partial" data-ng-if="!$parent.isReadOnly"  title="@LiveCasinoLang.lblUpdate"></span>
    </div>
    @switch (Model.TargetRole)
    {
        case CustomerRole.Super:
        <edit-super-pt-and-com></edit-super-pt-and-com>
            break;
        case CustomerRole.Master:
        <edit-master-pt-and-com></edit-master-pt-and-com>
            break;
        case CustomerRole.Agent:
            <edit-agent-pt-and-com></edit-agent-pt-and-com>
            break;
        case CustomerRole.Member:
            switch (Model.UplineRole)
            {
                case CustomerRole.Super:
                    <super-edit-member-pt></super-edit-member-pt>
                    break;
                case CustomerRole.Master:
                    <master-edit-member-pt></master-edit-member-pt>
                    break;
                default:
                    <agent-edit-member-pt-and-com></agent-edit-member-pt-and-com>
                    break;
            }
            break;
    }


    <div id="presetOnMemberModal" class="modal fade">
        <div class="modal-dialog custom-modal-dialog">
            <div class="modal-content custom-modal-content">
                <div class="modal-header custom-modal-header">
                    <button type="button" class="close custom-close" data-dismiss="modal">
                        <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                    <span class="modal-title custom-modal-title">
                        @if (LiveCasinoSettings.Settings.SystemId != (int)SystemType.Agency)
                        {
                            @LiveCasinoLang.lblConfirmUpdateMemberPT
                        }
                        else
                        {
                            @: &nbsp;
                        }
                    </span>
                </div>
                <div class="modal-body custom-modal-body">
                    <p>@(Model.Customer.Level == CustomerLevel.Master ? LiveCasinoLang.lblHaveChangeMasterPositionTaking : LiveCasinoLang.lblHaveChangeAgentPositionTaking)</p>
                    <p>@LiveCasinoLang.lblChangePTTo:</p>
                     <select 
                        data-ng-model="uplinePTOnMember.NewUplinePositionTaking" 
                        data-ng-options="item.id as item.value for item in uplinePTOnMemberOptions">
                        </select>
                    </div>
                <div class="modal-footer custom-modal-footer">
                    <input type="button" class="custom-btn" data-ng-click="updatePTOnMember(true)"  data-dismiss="modal" value="@LiveCasinoLang.lblYes" />
                    <input type="button" class="custom-btn" data-ng-click="updatePTOnMember(false)" data-dismiss="modal" value="@LiveCasinoLang.lblNo"/>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>
    <!-- /.modal -->
</div>
