@model SettingContext
@{
    Layout = null;
}
<div id="tblPtComSetting" class="pt-container" 
    data-ng-controller="PtAndComSettingController"
    data-update-href="@Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdatePtAndComSetting")">
    <div class="pt-title">
        Position Taking/Commission
        <input type="button" value="Update Partial" data-ng-click="updatePtAndComSetting()"/>
    </div>
    @switch ((CustRole)Model.TargetRoleId)
    {
        case CustRole.Super:
            <edit-super-pt-and-com></edit-super-pt-and-com>
            break;
    }
</div>
