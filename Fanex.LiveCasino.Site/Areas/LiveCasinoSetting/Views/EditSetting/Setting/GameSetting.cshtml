@model SettingContext
<div id="tblGameSetting" class="pt-container col-xs-12" 
    data-ng-controller="CustGameSettingController" 
    data-update-href="@Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdateGameSetting")">
    <div class="pt-title">
        <span class="pt-title-text">@LiveCasinoLang.lblGameSetting</span> <span data-ng-click="updateGameSetting()"
            class="btn-save-partial"></span>
    </div>
    <table class="game-setting col-xs-12">
        <thead>
            <tr>
                <td class="col-xs-3 right bold">
                    @LiveCasinoLang.lblGameType
                </td>
                <td class="col-xs-9 left bold">
                    @LiveCasinoLang.lblBettingLimit
                </td>
            </tr>
        </thead>
        <tbody>
            <tr data-ng-repeat="item in gameSetting">
                <td class="right">
                    {{item.Name}}
                </td>
                <td>
                    <span data-ng-repeat="betLimitItem in item.BettingLimit">
                        <br data-ng-show="{{$index % 6 == 0 && $index > 0}}" />
                        @if (Model.TargetRoleId != (int)CustRole.Member)
                        {
                            <label class="checkbox-inline">
                                <input id="betLimit{{betLimitItem.Id}}" type="checkbox" data-ng-model="betLimitItem.IsChecked" />
                                {{betLimitItem.Range}}
                            </label>
                        }
                        else
                        { 
                            <label class="radio-inline">
                                <input id="betLimit{{betLimitItem.Id}}" type="radio" name="{{item.Name}}" data-ng-model="item.CheckedStakeLevelId"
                                    value="{{betLimitItem.Id}}" />
                                {{betLimitItem.Range}}
                            </label>
                        }
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
</div>
