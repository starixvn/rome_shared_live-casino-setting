@{
    Layout = null;
}
@model SettingContext
<div id="tblCustInfo" class="col-xs-12">
    <table data-ng-controller="CustomerInfoController" class="cust-info">
        <tr class="title">
            <td colspan="4" class="center">
                @LiveCasinoLang.lblCustomerInformation
            </td>
        </tr>
        <tr>
            <td class="right bold">
                @LiveCasinoLang.lblUsername:
            </td>
            <td class="left">
                {{custInfo.UserName}}
            </td>
            <td class="right bold">
                @LiveCasinoLang.lblNickname:
            </td>
            <td class="left">
                @if(LiveCasinoSettings.Settings.SystemId != (int)SystemType.Agency)
                {
                    @:{{custInfo.NickName}}
                }
            </td>
        </tr>
        <tr>
            <td class="right bold">
                @LiveCasinoLang.lblFirstName:
            </td>
            <td class="left">
                {{custInfo.FirstName}}
            </td>
            <td class="right bold">
                @LiveCasinoLang.lblLastName:
            </td>
            <td class="left">
                {{custInfo.LastName}}
            </td>
        </tr>
        <tr>
            <td class="right bold">
                @LiveCasinoLang.lblPhone:
            </td>
            <td class="left">
                {{custInfo.Phone}}
            </td>
            <td class="right bold">
                @LiveCasinoLang.lblMobilePhone:
            </td>
            <td class="left">
                {{custInfo.Mobile}}
            </td>
        </tr>
        <tr>
            <td class="right bold">
                @LiveCasinoLang.lblFax:
            </td>
            <td class="left">
                {{custInfo.Fax}}
            </td>
            @if (Model.IsAgentEditingMember)
            {
                <td class="right bold">
                    @LiveCasinoLang.lblEnable:
                </td>
                <td class="left">
                    <input type="checkbox" data-ng-model="enableLiveCasino" data-ng-disabled="disableCheckBoxLiveCasino" />
                </td>
            }
            else
            {
                <td class="right bold">
                </td>
                <td class="left">
                </td>
            }
        </tr>
    </table>
</div>
