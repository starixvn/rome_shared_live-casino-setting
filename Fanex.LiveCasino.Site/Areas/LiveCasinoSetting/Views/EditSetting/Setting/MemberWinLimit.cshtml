@model LiveCasinoSettingContext
<div id="tblMaxWinLimit" class="pt-container col-xs-12" data-ng-controller="CustomerWinLimitController">
    <div class="pt-title">
        <span class="pt-title-text">@LiveCasinoLang.lblMemberWinLimit</span><span data-ng-click="updateWinLimitSetting()"
            data-ng-if="!$parent.isReadOnly" class="btn-save-partial"  title="@LiveCasinoLang.lblUpdate"></span>
    </div>
    <table class="win-limit">
        <tbody>
            <tr>
                <td class="col-xs-3 right bold">
                    @LiveCasinoLang.lblMaximumWin
                </td>
                <td class="col-xs-4">
                    <select id="maxWinLimit" name="maxWinLimit" data-ng-options="opt as opt.lable for opt in maxWinLimits"
                        data-ng-disabled="$parent.isReadOnly" data-ng-model="maxWinLimitModel.Max">
                    </select>
                    <span>&nbsp;@LiveCasinoLang.lblOnGivenCredit</span>
                </td>
                <td class="col-xs-6">
                    <label class="checkbox-inline">
                        <input type="checkbox" id="dailyAutoReset" name="dailyAutoReset" data-ng-model="maxWinLimitModel.IsAutoReset"
                            data-ng-disabled="!maxWinLimitModel.UplineAutoReset||$parent.isReadOnly">@LiveCasinoLang.lblDailyAutoResetLimit
                    </label>
                </td>
            </tr>
            @if (Model.Customer.Level == CustomerLevel.Member)
            { 
                <tr>
                    <td class="col-xs-3 right bold">
                        @LiveCasinoLang.lblCurrentWinLimit
                    </td>
                    <td class="col-xs-3 left ng-binding">
                        <div id="showWinLimit" class="member-win-limit" data-ng-click="showCurrentWinLimit(@Model.Customer.Id)" data-ng-show="!isShowCurrentWinLimit">
                            @LiveCasinoLang.lblClickToViewCurrentWinLimit
                        </div>
                        <div class="current-win-limit {{isPercentShowRedColor?'text-red':''}}" id="currentWinLimit"
                            data-ng-show="isShowCurrentWinLimit && currentWinLimit !='-1'">
                            {{percent}} %</div>
                        <div class="current-win-limit" id="currentWinLimit" data-ng-show="isShowCurrentWinLimit && currentWinLimit == '-1'">
                            @LiveCasinoLang.lblUnlimited</div>
                        <span id="ofMaxCredit" data-ng-show="isShowCurrentWinLimit && currentWinLimit !='-1'">@LiveCasinoLang.lblOf
                            {{currentWinLimit}}</span>
                    </td>
                    <td class="col-xs-3">
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @Html.Hidden("memberWinLimitLink", Url.Content("~/LiveCasinoSetting/Setting/GetCurrentWinLimit"))
</div>
