@model SettingContext
@{
    Layout = "~/Areas/LiveCasinoSetting/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "EditSetting";
    var editQueryString = string.Format(
        "custId={0}&roleId={1}&adminId={2}&targetCustId={3}&targetRoleId={4}&formType={5}",
        Model.CustId,
        Model.RoleId,
        Model.AdminId,
        Model.TargetCustId,
        Model.TargetRoleId,
        Model.FormType);
}
@section modeldata
{
    <script type="text/javascript" src="~/LiveCasinoSetting/LiveCSSetting/GetSettingForUpdate?@(editQueryString)"></script>
}
<div id="tblSetting" 
    data-ng-app="fanex.liveCasinoSetting" 
    data-ng-controller="CustomerSettingController" 
    data-update-href="@Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdateLiveCasinoSetting")" 
    style="display:none;"
    class="edit-setting-livecs">

    <div id="updatedResult" class="updated-result col-xs-12" data-ng-show="commandResults.length > 0">
        <p data-ng-repeat="result in commandResults" data-ng-class="{'bg-success': result.Code <= 0,'bg-danger': result.Code > 0}">
            {{result.Message}}
        </p>
    </div>

    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/CustomerInfo.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/PTAndCom.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/MemberWinLimit.cshtml")
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/GameSetting.cshtml")
    <div class="update-setting col-xs-12">
        <input type="button" class="btn btn-primary btn-sm" data-ng-click="validateAndUpdateSetting()" value="Update" />
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/areasjs/livecasino/setting")
}
