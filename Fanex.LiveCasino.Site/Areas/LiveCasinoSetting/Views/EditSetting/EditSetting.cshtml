@model SettingContext
@{
    Layout = "~/Areas/LiveCasinoSetting/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "EditSetting";
    var editQueryString = string.Format(
        "uplineId={0}&uplineRoleId={1}&adminId={2}&targetCustId={3}&targetRoleId={4}&formType={5}&language={6}&targetCustIds={7}&&targetUsernames={8}&isEditMultiple={9}&directUplineId={10}&targetSyncStatus={11}",
        Model.UplineId,
        Model.UplineRoleId,
        Model.AdminId,
        Model.TargetCustId,
        Model.TargetRoleId,
        Model.FormType,
        Model.Language,
        Model.TargetCustIds,
        Model.TargetUsernames,
        Model.IsEditMultiple,
        Model.DirectUplineId,
        Model.TargetSyncStatus);
}
@section modeldata
{
    <script type="text/javascript" src="@(Url.Content("~/LiveCasinoSetting/LiveCSSetting/GetSettingForUpdate"))?@(editQueryString)"></script>
}
<div id="tblSetting" 
    data-ng-app="fanex.liveCasinoSetting" 
    data-ng-controller="CustomerSettingController" 
    data-update-href="@Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdateLiveCasinoSetting")" 
    style="display:none;"
    class="edit-setting-livecs">
    <div id="updatedResult" class="updated-result col-xs-12" data-ng-show="mainResult.CommandResultsList.length > 0">
        <div class="main-message-icon" data-ng-class="{'main-icon-success': mainResult.IsSuccessful,'main-icon-error': !mainResult.IsSuccessful}">
        </div>
        <div class="main-message">
            <div data-ng-repeat="subResult in mainResult.CommandResultsList">
                <div class="message-user-name">
                    {{subResult.Name}}</div>
                <div class="sub-message" data-ng-repeat="result in subResult.Results">
                    <div class="sub-message-icon" data-ng-class="{'sub-icon-success': result.IsSuccessful,'sub-icon-error': !result.IsSuccessful}"
                        data-ng-show="!mainResult.isUnAuthorized">
                    </div>
                    <div class="message-content" data-ng-class="{'message-content-success': result.IsSuccessful,'message-content-error': !result.IsSuccessful, 'message-content-unauthorized': mainResult.isUnAuthorized}"
                        data-ng-bind-html="result.Message">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="setting-header bold col-xs-12">
        <span class="setting-header-first-icon"></span>
        <span class="setting-header-text">@(Model.IsEditMultiple ? LiveCasinoLang.lblEditMultipleLiveCasino : LiveCasinoLang.lblEditLiveCasino)</span>
        <span class="setting-header-last-icon"></span>
    </div>
    @if (Model.IsEditMultiple)
    {
        @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/CustomerInfoMultiple.cshtml", Model)
    }
    else
    {
        @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/CustomerInfo.cshtml", Model)
    }
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/PTAndCom.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/MemberWinLimit.cshtml")
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/GameSetting.cshtml")
    <div class="update-setting col-xs-12">
        <input type="button" class="update-setting-submit" data-ng-click="validateAndUpdateSetting()"  title="@LiveCasinoLang.lblUpdate"
            value="@LiveCasinoLang.lblUpdate" />
    </div>
</div>
<div class="live-casino-loading">
    <span class="loading-icon"></span>
</div>
@section scripts
{
    @Scripts.Render("~/areasjs/livecasino/setting")
}
