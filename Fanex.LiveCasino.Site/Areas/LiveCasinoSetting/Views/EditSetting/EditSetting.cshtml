@model SettingContext
@{
    Layout = "~/Areas/LiveCasinoSetting/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "EditSetting";
}
@section css
{
    @if (Model.SystemId == (int)SystemType.Accounting)
    {
        <link type="text/css" rel="Stylesheet" href="@Url.Content("~/areas/LiveCasinoSetting/content/bootstrap.css")" />
        <link type="text/css" rel="Stylesheet" href="@Url.Content("~/areas/LiveCasinoSetting/content/fanex-live-casino-setting.css")" />
        <link type="text/css" rel="Stylesheet" href="@Url.Content("~/areas/LiveCasinoSetting/content/fanex-live-casino-setting-override.css")" />
    }
    else
    {
        @Styles.Render("~/areas/LiveCasinoSetting/content/bundlecss")
    }
}
@section modeldata
{
    <script type="text/javascript">
        var currentLaguageKey = '@(Model.LangKey)';
        @(Html.Raw(ViewBag.CustSettingViewModel ?? string.Empty))
    </script>
}
<div id="tblSetting" 
    data-ng-app="fanex.liveCasinoSetting" 
    data-ng-controller="CustomerSettingController" 
    data-update-href="@Url.Content("~/LiveCasinoSetting/LiveCSSetting/UpdateLiveCasinoSetting")" 
    style="display:none;"
    class="edit-setting-livecs">
    <div id="updatedResult" class="updated-result col-xs-12" data-ng-show="mainResult.CommandResultsList.length > 0">
        <div class="main-message-icon" data-ng-class="{'main-icon-success': mainResult.IsSuccessful,'main-icon-error': !mainResult.IsSuccessful}">
        </div>
        <div class="main-message">
            <div data-ng-repeat="subResult in mainResult.CommandResultsList">
                <div class="message-user-name">
                    {{subResult.Name}}</div>
                <div class="sub-message" data-ng-repeat="result in subResult.Results">
                    <div class="sub-message-icon" data-ng-class="{'sub-icon-success': result.IsSuccessful,'sub-icon-error': !result.IsSuccessful}"
                        data-ng-show="!mainResult.isUnAuthorized">
                    </div>
                    <div class="message-content" data-ng-class="{'message-content-success': result.IsSuccessful,'message-content-error': !result.IsSuccessful, 'message-content-unauthorized': mainResult.isUnAuthorized}"
                        data-ng-bind-html="result.Message">
                    </div>
                </div>
            </div>
        </div>
    </div>
    @{
        var buttonClass = string.Empty;
        var buttonText = LiveCasinoLang.lblUpdate;

        switch (Model.SystemId)
        {

            case (int)SystemType.Accounting:
                buttonClass = "update-setting-accounting-submit";
                
                <div class="setting-header-accounting bold col-xs-12">
                    <span class="setting-header-first-icon"></span><span class="setting-header-text">@(Model.IsEditMultiple ? LiveCasinoLang.lblEditMultipleLiveCasino : LiveCasinoLang.lblEditLiveCasino)</span>
                    <span class="setting-header-last-icon"></span>
                </div>
                                                                                                 break;
            case (int)SystemType.Agency:
                                                                                                 buttonClass = "update-setting-agency-submit";
                
                <div class="setting-header-agency bold col-xs-12">
                    <span class="setting-header-text">@(Model.IsEditMultiple ? LiveCasinoLang.lblEditMultipleLiveCasino : LiveCasinoLang.lblEditLiveCasino)</span>
                </div>
                                                  break;
            case (int)SystemType.ExtAccounting:
                <div class="update-setting col-xs-12">
                    <input type="button" class="update-setting-ext-acc-submit" data-ng-click="validateAndUpdateSetting()"  title="@LiveCasinoLang.lblSubmit"
                        value="@LiveCasinoLang.lblSubmit" data-ng-show="!isReadOnly" />
                </div>
              buttonText = LiveCasinoLang.lblSubmit;
              buttonClass = "update-setting-ext-acc-submit";
              break;
        }
    }

    <div class="warning-result col-xs-12" data-ng-show="mainResult.Warning.IsShow">
        <div class="sub-message-icon sub-icon-warning">
        </div>
        <div class="message-content message-content-warning">{{mainResult.Warning.Message}}            
        </div>
    </div>

    @if (Model.IsEditMultiple)
    {
        @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/CustomerInfoMultiple.cshtml", Model)
    }
    else
    {
        @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/CustomerInfo.cshtml", Model)
    }
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/PTAndCom.cshtml", Model)
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/MemberWinLimit.cshtml")
    @Html.Partial("~/Areas/LiveCasinoSetting/Views/EditSetting/Setting/GameSetting.cshtml")

    <div class="update-setting col-xs-12">
        @if (Model.SystemId == (int)SystemType.Agency)
        {
            <span class="update-setting-agency-submit-left"  data-ng-show="!isReadOnly"></span>
        }
        <input type="button" class="@(buttonClass)" data-ng-click="validateAndUpdateSetting()"  title="@buttonText"
            value="@buttonText" data-ng-show="!isReadOnly" />
    </div>
</div>
<div class="live-casino-loading">
    <span class="loading-icon"></span>
</div>
@section scripts
{
    @if (Model.SystemId == (int)SystemType.Accounting)
    {
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/live-casino-lang.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.en-US.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.ja-JP.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.ko-KR.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.th-TH.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.vi-VN.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.zh-CN.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/language/LiveCasinoLang.zh-TW.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/fanex-live-casino-setting.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/services/cust-setting-service.js")")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/services/cust-win-limit-service.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/services/cust-game-setting-service.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/services/pt-and-com-setting-service.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/controllers/cust-info-controller.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/controllers/cust-setting-controller.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/controllers/cust-win-limit-controller.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/controllers/pt-and-com-setting-controller.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/controllers/cust-game-setting-controller.js")"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/directives/pt-and-com-setting-directive.js")"></script>
    }
    else
    {
        @Scripts.Render("~/areasjs/livecasino/setting")
    }
}
